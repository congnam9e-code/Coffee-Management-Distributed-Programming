package com.cafe.client.socket;

import com.cafe.common.network.Request;
import com.cafe.common.network.Response;
import java.io.ObjectInputStream;
import java.io.ObjectOutputStream;
import java.net.Socket;

public class SocketClient {
    private static SocketClient instance;
    private Socket socket;
    private ObjectOutputStream out;
    private ObjectInputStream in;

    private SocketClient() {
        try {
            socket = new Socket(com.cafe.common.network.Config.SERVER_IP, com.cafe.common.network.Config.SERVER_PORT);
            out = new ObjectOutputStream(socket.getOutputStream());
            in = new ObjectInputStream(socket.getInputStream());
        } catch (Exception e) {
            e.printStackTrace();
        }
    }

    public static SocketClient getInstance() {
        if (instance == null) {
            instance = new SocketClient();
        }
        return instance;
    }

    public Response sendRequest(Request request) {
        try {
            out.writeObject(request);
            out.flush();
            return (Response) in.readObject();
        } catch (Exception e) {
            e.printStackTrace();
            return null;
        }
    }
}
