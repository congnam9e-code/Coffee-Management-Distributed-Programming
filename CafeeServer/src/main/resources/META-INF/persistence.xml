<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="CafePU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        
        <class>com.cafe.common.entity.Employee</class>
        <class>com.cafe.common.entity.Category</class>
        <class>com.cafe.common.entity.Product</class>
        <class>com.cafe.common.entity.CoffeeTable</class>
        <class>com.cafe.common.entity.Bill</class>
        <class>com.cafe.common.entity.BillDetail</class>

        <properties>
            <!-- MSSQL Server Connection Settings -->
            <property name="jakarta.persistence.jdbc.driver" value="com.microsoft.sqlserver.jdbc.SQLServerDriver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:sqlserver://127.0.0.1:1433;databaseName=CafeDB;encrypt=false;trustServerCertificate=true;loginTimeout=45;queryTimeout=10;lockTimeout=5000;socketTimeout=45000;"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value="123456"/>

            <!-- JPA Query & Lock Timeouts (ngắn hơn Client READ_TIMEOUT_MS để tránh commit trễ sau timeout) -->
            <property name="jakarta.persistence.query.timeout" value="10000"/>
            <property name="jakarta.persistence.lock.timeout" value="5000"/>
            
            <!-- Hibernate Settings -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.SQLServerDialect"/>
            <!-- Không quét DDL mỗi lần bật Server để khởi động nhanh (tự động update nếu DB chưa có bảng) -->
            <property name="hibernate.hbm2ddl.auto" value="none"/>
            <property name="hibernate.connection.pool_size" value="20"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="false"/>
        </properties>
    </persistence-unit>
</persistence>